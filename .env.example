# ==========================================
# ZoneMatrix Pro — Environment Configuration
# ==========================================
# Copy this file to .env and fill in your details:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control!

# HTTP Server Port (Default: 3000)
PORT=3000

# Shared site password. Leave SITE_PASSWORD empty to leave the gate off.
# Use letters and numbers only so the server env file stays easy to read.
SITE_USER=zonematrix
SITE_PASSWORD=

# Upstox Live Market Data Configuration
# Register your app at: https://developer.upstox.com
#
# 1. RECOMMENDED: Upstox Analytics Token (Valid for 1 full year, NO daily 3:30 AM expiration)
# Generate from: https://developer.upstox.com -> Open your App -> Analytics tab -> Generate Token
UPSTOX_ANALYTICS_TOKEN=your_upstox_analytics_token_here

# 2. OPTIONAL: OAuth API Key, Secret & Redirect (Only needed if using OAuth interactive login)
UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
UPSTOX_REDIRECT_URI=http://localhost:3000

# 3. LEGACY / FALLBACK: Standard Daily OAuth Token (Expires daily at 3:30 AM IST)
UPSTOX_ACCESS_TOKEN=

# ==========================================
# ZoneMatrix Pro — Git Ignore Rules
# ==========================================

# Environment variables & secrets (CRITICAL)
.env
.env.local
.env.*.local
*.env
*.pem
*.key
*.cert
_cache/upstox-config.json
upstox-config.json

# Dependencies
node_modules/
package-lock.json.backup

# Runtime cache and large generated data
_cache/
.cache/
tmp/
temp/
*.tmp

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
